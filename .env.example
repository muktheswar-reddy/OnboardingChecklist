# ==============================================================================
# OnboardingChecklist Platform Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development

# Server Port
PORT=5000

# MongoDB Connection String (Atlas URI or local mongodb daemon)
# If local mongod is not reachable, the system automatically falls back to an embedded
# In-Memory MongoDB instance for zero-configuration testing and evaluation.
MONGODB_URI=mongodb://localhost:27017/onboarding_checklist

# JWT Authentication
JWT_SECRET=onboarding_checklist_enterprise_super_secret_jwt_key_2024
JWT_EXPIRE=7d

# Bcrypt salt hashing rounds
BCRYPT_ROUNDS=10

# Frontend URL (CORS allowed origin)
CORS_ORIGIN=http://localhost:5173

